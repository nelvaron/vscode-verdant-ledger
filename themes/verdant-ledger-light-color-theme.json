  "tokenColors": [
    {
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml"
      ],
      "settings": {
        "foreground": "#5d6864"
      }
    },
    {
      "scope": [
        "string.unquoted.plain.out.yaml",
        "string.quoted.single.yaml",
        "string.quoted.double.yaml"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "constant.language.boolean.yaml",
        "constant.language.null.yaml",
        "constant.numeric.yaml"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "punctuation.separator.key-value.yaml",
        "punctuation.definition.block.sequence.item.yaml",
        "punctuation.definition.block.mapping.yaml"
      ],
      "settings": {
        "foreground": "#66716d"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json string.quoted.double.json",
        "meta.mapping.key.yaml"
      ],
      "settings": {
        "foreground": "#5d6864"
      }
    },
    {
      "scope": [
        "punctuation.definition.array.json",
        "punctuation.definition.dictionary.json",
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.dictionary.pair.json",
        "punctuation.separator.array.json"
