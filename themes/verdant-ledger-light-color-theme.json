  "tokenColors": [
    {
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml"
      ],
      "settings": {
        "foreground": "#5d6864"
      }
    },
    {
      "scope": [
        "string.unquoted.plain.out.yaml",
        "string.quoted.single.yaml",
        "string.quoted.double.yaml"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "constant.language.boolean.yaml",
        "constant.language.null.yaml",
        "constant.numeric.yaml"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "punctuation.separator.key-value.yaml",
        "punctuation.definition.block.sequence.item.yaml",
        "punctuation.definition.block.mapping.yaml"
      ],
      "settings": {
        "foreground": "#8c9894"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json string.quoted.double.json",
        "meta.mapping.key.yaml"
      ],
      "settings": {
        "foreground": "#5d6864"
      }
    },
    {
      "scope": [
        "punctuation.definition.array.json",
        "punctuation.definition.dictionary.json",
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.dictionary.pair.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#8c9894"
      }
    },
    {
      "scope": [
        "storage.type.function.js",
        "storage.type.function.ts",
        "storage.type.class.js",
        "storage.type.class.ts",
        "keyword.control.js",
        "keyword.control.ts",
        "keyword.operator.expression.typeof.js",
        "keyword.operator.expression.typeof.ts",
        "keyword.control.python",
        "storage.type.function.python",
        "storage.type.class.python",
        "keyword.control.toml",
        "keyword.control.import.tex",
        "keyword.control.word.tex"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "entity.name.function.js",
        "entity.name.function.ts",
        "support.function.builtin.python",
        "entity.name.function.python",
        "support.function.tex"
      ],
      "settings": {
        "foreground": "#1b2320"
      }
    },
    {
      "scope": [
        "entity.name.type.ts",
        "entity.name.type.js",
        "entity.name.class.ts",
        "entity.name.class.js",
        "entity.name.class.python",
        "support.type.python",
        "entity.name.section.tex",
        "entity.name.environment.tex",
        "entity.name.environment.begin.tex"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "variable.parameter.js",
        "variable.parameter.ts",
        "variable.parameter.python"
      ],
      "settings": {
        "foreground": "#5d6864",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.scss"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#5d6864"
      }
    },
    {
      "scope": [
        "constant.numeric.css",
        "constant.numeric.scss",
        "constant.numeric.toml",
        "constant.numeric.python",
        "constant.numeric.js",
        "constant.numeric.ts"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.xhtml",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.xhtml"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.xml",
        "punctuation.definition.tag.xhtml",
        "punctuation.separator.key-value.html",
        "punctuation.separator.key-value.xml"
      ],
      "settings": {
        "foreground": "#8c9894"
      }
    },
    {
      "scope": [
        "entity.name.section.toml",
        "entity.name.table.toml"
      ],
      "settings": {
        "foreground": "#2d6a3b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#1b2320",
        "background": "#eef2ef"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#2d6a3b",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "markup.inserted.diff"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "markup.deleted.diff"
      ],
      "settings": {
        "foreground": "#a8322a"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#66716d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#1b2320"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#1b2320"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#5d6864",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.tag"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5d6864"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a8322a",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#2d6a3b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#1b2320",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#5d6864",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a8322a"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2d6a3b"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8a6408"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#66716d",
      "italic": true
    },
    "keyword": "#8a6408",
    "number": "#8a6408",
    "string": "#2d6a3b",
    "function": "#1b2320",
    "method": "#1b2320",
    "class": "#2d6a3b",
    "interface": "#2d6a3b",
    "type": "#2d6a3b",
    "enum": "#2d6a3b",
    "parameter": "#5d6864",
    "property": "#1b2320",
    "variable": "#1b2320",
    "operator": "#5d6864",
    "decorator": "#8a6408",
    "regexp": "#2d6a3b",
    "label": "#8a6408"
  }
}
