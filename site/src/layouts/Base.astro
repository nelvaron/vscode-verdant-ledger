---
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/atkinson-hyperlegible-next/400.css";
import "@fontsource/atkinson-hyperlegible-next/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import iconPng from "../../../images/icon.png";
import iconSvg from "../../../images/icon.svg";
import { url } from "../lib/url.js";

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url("og.png"), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f8f6" />
    <link rel="icon" href={iconSvg.src} type="image/svg+xml" />
    <link rel="icon" href={iconPng.src} type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href={iconPng.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Verdant Ledger Light: a calm light theme for Visual Studio Code" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Mastodon: credit the author on link previews, and verify the site on the profile. -->
    <meta name="fediverse:creator" content="@nelvaron@mastodon.social" />
    <link rel="me" href="https://mastodon.social/@nelvaron" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
