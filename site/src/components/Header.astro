---
import Logo from "./Logo.astro";
import { url } from "../lib/url.js";
import { links } from "../lib/repo.js";

const { current = "home" } = Astro.props;
const items = [
  { href: url("#features"), label: "Features" },
  { href: url("palette/"), label: "Palette", key: "palette" },
  { href: url("#accessibility"), label: "Accessibility" },
  { href: url("#install"), label: "Install" },
  { href: links.repository, label: "GitHub" },
];
---
<header class="site-header">
  <nav aria-label="Main" class="wrap nav">
    <a href={url()} class="brand">
      <Logo />
      <span>Verdant Ledger</span>
    </a>
    <ul class="nav-links">
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={item.key === current ? "page" : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 14px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-links a {
    display: inline-block;
    padding: 12px 2px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>
